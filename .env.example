# ═══════════════════════════════════════════════════════════════════════════
# VERVOX PWA — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
#
# SETUP:
#   1. Copy this file to `.env.local` (never commit it—add to .gitignore)
#   2. Fill in the values below from your service provider dashboards
#   3. In Vercel, also set these in Project Settings → Environment Variables
#
# CLIENT-SIDE BEHAVIOR:
#   • Variables are read from: import.meta.env (Vite) and process.env (CRA/Next)
#   • Both REACT_APP_* and VITE_* spellings are supported
#   • No keys are hardcoded in JavaScript—all come from environment variables
#   • If Firebase keys are missing, Vervox falls back to local offline-first mode
#
# SERVER-SIDE (WEBHOOK):
#   • Webhook runs on Vercel Functions (api/flutterwave-webhook.js)
#   • Uses FLW_* and FIREBASE_* variables to verify & update purchases
#   • These MUST be set as server-side environment variables (never expose to frontend)
#
# ═══════════════════════════════════════════════════════════════════════════

# ── Firebase (Firestore + Anonymous Auth + Storage) ──────────
# Without these Vervox runs its offline-first local engine.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Vite-native aliases of the same values (use one set or the other)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Flutterwave (NGN payments) ───────────────────────────────
# Get it from Flutterwave Dashboard → Settings → API → Public Key
REACT_APP_FLUTTERWAVE_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# ── Web Push (alarms & partner updates) ──────────────────────
VITE_VAPID_PUBLIC_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ SERVER-SIDE ONLY — DO NOT EXPOSE TO FRONTEND
# These variables are ONLY for the /api/flutterwave-webhook endpoint.
# Set them in Vercel → Project Settings → Environment Variables (with visibility
# set to "Production & Preview" and "Exclude from Source Code" checked).
# ═══════════════════════════════════════════════════════════════════════════

# ── Flutterwave Webhook (Vercel Function) ────────────────────
# Get from: https://dashboard.flutterwave.com/settings/webhooks
# This hash is sent in the X-Flutterwave-Signature (or Verif-Hash) header
FLW_SECRET_HASH=
FLW_SECRET_KEY=FLWSECK_LIVE_your_secret_key_here

# ── Firebase Admin SDK (Webhook Only) ─────────────────────────
# Generate via: Firebase Console → Project Settings → Service Accounts
# Download the JSON key, then set these values:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# IMPORTANT: Replace newlines in the private key with literal \n (not actual line breaks)
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEvQIBA...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT & TESTING
# ═══════════════════════════════════════════════════════════════════════════

# Leave all Firebase credentials empty to run in offline-first local mode.
# All tasks are stored in IndexedDB with no cloud sync.
# The welcome message explains pairing without needing Firestore.

# To test with a local Firestore emulator, set the emulator host:
# VITE_FIRESTORE_EMULATOR_HOST=localhost:8080

